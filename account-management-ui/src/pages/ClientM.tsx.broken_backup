// Date format utilities (DD/MM/YYYY)
const formatDateToDDMMYYYY = (dateStr: any): string => {
  if (!dateStr && dateStr !== 0) return '';
  try {
    let date: Date;
    
    // If it's a number (Excel date serial), convert it
    if (typeof dateStr === 'number') {
      // Excel stores dates as days since 1900-01-01
      // Excel serial date: 1 = 1900-01-01, 44562 = 2022-01-01, etc.
      // Adjustment: 25567 represents days from 1900-01-01 to 1970-01-01
      // But we need to account for the leap year bug in Excel (1900 is not a leap year but Excel treats it as one)
      
      // More accurate formula: date = (serial - 1) * 24 * 60 * 60 * 1000 + epoch
      const excelEpochMs = new Date(1900, 0, 1).getTime(); // 1900-01-01 in local timezone
      const serialDate = Math.floor(dateStr); // Ensure it's a whole number
      
      // Account for Excel's leap year bug (Feb 29, 1900 doesn't exist)
      const dayOffset = serialDate > 59 ? 1 : 0; // Serial 60 is Feb 29, 1900 (fictitious)
      date = new Date(excelEpochMs + (serialDate - dayOffset - 1) * 24 * 60 * 60 * 1000);
    } else {
      dateStr = String(dateStr).trim();
      
      // If it's already in DD/MM/YYYY format, validate and return
      if (/^\d{2}\/\d{2}\/\d{4}$/.test(dateStr)) {
        const [day, month, year] = dateStr.split('/');
        const d = parseInt(day, 10);
        const m = parseInt(month, 10);
        const y = parseInt(year, 10);
        
        // Validate the date
        if (d >= 1 && d <= 31 && m >= 1 && m <= 12 && y >= 1900) {
          return dateStr; // Return as-is if valid
        }
      }
      
      // If it's YYYY-MM-DD format, convert it
      if (/^\d{4}-\d{2}-\d{2}$/.test(dateStr)) {
        date = new Date(dateStr + 'T00:00:00Z');
      } else {
        // Try parsing as-is
        date = new Date(dateStr);
      }
    }
    
    if (isNaN(date.getTime())) return String(dateStr);
    
    const day = String(date.getDate()).padStart(2, '0');
    const month = String(date.getMonth() + 1).padStart(2, '0');
    const year = date.getFullYear();
    
    // Validate the output date
    if (year < 1900 || year > 2100) {
      return String(dateStr); // Return original if year is unreasonable
    }
    
    return `${day}/${month}/${year}`;
  } catch {
    return String(dateStr);
  }
};

const parseDDMMYYYY = (dateStr: string): string => {
  if (!dateStr) return '';
  try {
    // If already in YYYY-MM-DD, return as is
    if (/^\d{4}-\d{2}-\d{2}$/.test(dateStr)) {
      return dateStr;
    }
    
    // Parse DD/MM/YYYY format
    if (/^\d{2}\/\d{2}\/\d{4}$/.test(dateStr)) {
      const [day, month, year] = dateStr.split('/');
      return `${year}-${month}-${day}`;
    }
    
    return dateStr;
  } catch {
    return dateStr;
  }
};

