            message.error('No data found in file');
            return;
          }

          const newRequests: ClientRequest[] = jsonData.map((row, idx) => {
            const totalSno = requests.length + idx + 1;
            const newKey = String(totalSno);
            const processingStatusInput = String(row['Processing Status'] || row['Processing status'] || row['processing Status'] || '').trim();
            const overallStatusInput = String(row['Overall Status'] || row['Overall status'] || row['overall Status'] || '').trim();
            
            // Map display values to internal codes
            const processingStatusCode = PROCESSING_STATUS_MAP[processingStatusInput] || processingStatusInput;
            const overallStatusCode = OVERALL_STATUS_MAP[overallStatusInput] || overallStatusInput;
            
            // Validate status values (now checking display names from the file)
            const processingStatus = VALID_PROCESSING_STATUSES.has(processingStatusInput) 
              ? processingStatusCode as ProcessingStatusType
              : 'accepted_staffing';
            const overallStatus = VALID_OVERALL_STATUSES.has(overallStatusInput)
              ? overallStatusCode as OverallStatusType
              : 'not_started';
            
            // Log warnings if invalid statuses were provided
            if (processingStatusInput && !VALID_PROCESSING_STATUSES.has(processingStatusInput)) {
              console.warn(`Row ${totalSno}: Invalid Processing Status "${processingStatusInput}" - using default "Accepted by Staffing Team"`);
            }
            if (overallStatusInput && !VALID_OVERALL_STATUSES.has(overallStatusInput)) {
              console.warn(`Row ${totalSno}: Invalid Overall Status "${overallStatusInput}" - using default "Not Started"`);
            }
            
            // Handle date fields - they might be Date objects from XLSX or strings
            let rawRequestRaised: any = row['Request Raised'] || row['Request raised'] || row['request Raised'];
            let rawUpdatedOn: any = row['Updated on'] || row['Updated On'] || row['updated on'];
            
            // Convert Date objects to string if needed
            if (rawRequestRaised instanceof Date) {
              rawRequestRaised = formatDateToDDMMYYYY(rawRequestRaised.getTime());
            } else {
              rawRequestRaised = String(rawRequestRaised || '');
            }
            
            if (rawUpdatedOn instanceof Date) {
              rawUpdatedOn = formatDateToDDMMYYYY(rawUpdatedOn.getTime());
            } else {
              rawUpdatedOn = String(rawUpdatedOn || '');
            }
            
            return {
              key: newKey,
              sno: String(totalSno),
              beelineId: String(row['Beeline ID'] || row['Beeline Id'] || row['beeline ID'] || ''),
              description: String(row['Description'] || row['description'] || ''),
              raisedBy: String(row['Raised by'] || row['Raised By'] || row['raised by'] || ''),
              requestRaised: formatDateToDDMMYYYY(rawRequestRaised),
              accountAnchorAssigned: String(row['Account Anchor'] || row['Account Anchor Assigned'] || row['Account Anchor assigned'] || row['account Anchor Assigned'] || ''),
              processingStatus: processingStatus as ProcessingStatusType,
              updatedOn: formatDateToDDMMYYYY(rawUpdatedOn),
              overallStatus: overallStatus as OverallStatusType,
            };
          });

          // Check for invalid statuses
          let invalidStatusCount = 0;
          jsonData.forEach((row, idx) => {
            const processingStatusInput = String(row['Processing Status'] || row['Processing status'] || row['processing Status'] || '').trim();
            const overallStatusInput = String(row['Overall Status'] || row['Overall status'] || row['overall Status'] || '').trim();
            
            if (processingStatusInput && !VALID_PROCESSING_STATUSES.has(processingStatusInput)) {
              invalidStatusCount++;
            }
            if (overallStatusInput && !VALID_OVERALL_STATUSES.has(overallStatusInput)) {
              invalidStatusCount++;
            }
          });

          setRequests([...requests, ...newRequests]);
          
          if (invalidStatusCount > 0) {
            message.warning(
              `${newRequests.length} records imported. âš ï¸ Warning: ${invalidStatusCount} invalid status value(s) found - defaults applied. Check browser console for details.`
            );
          } else {
            message.success(`${newRequests.length} requests imported successfully`);
          }
        } catch (error) {
          const errorMsg = error instanceof Error ? error.message : 'Error parsing file';
          message.error(`Error: ${errorMsg}. Please check the format.`);
        }
      };

      reader.onerror = () => {
        message.error('Failed to read file');
      };

      reader.readAsBinaryString(file);
    } catch (error) {
      const errorMsg = error instanceof Error ? error.message : 'Upload error';
      message.error(`Error: ${errorMsg}`);
    }
    return false;
