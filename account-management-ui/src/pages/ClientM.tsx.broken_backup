            message.error('No worksheet found in file');
            return;
          }

          const worksheet = workbook.Sheets[sheetName];
          if (!worksheet) {
            message.error('Invalid worksheet');
            return;
          }

          const jsonData: ExcelRow[] = XLSX.utils.sheet_to_json(worksheet, { defval: '' });
