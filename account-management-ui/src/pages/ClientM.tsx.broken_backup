          setEditDrawer(false);
          form.resetFields();
          setEditingRequest(null);
        }}
        open={editDrawer}
        width={600}
      >
        <Form
          form={form}
          layout="vertical"
          onFinish={handleSaveEdit}
        >
          <Form.Item
            name="beelineId"
            label="Beeline ID"
            rules={[{ required: true, message: 'Please enter Beeline ID' }]}
          >
            <Input placeholder="Enter Beeline ID" />
          </Form.Item>

          <Form.Item
            name="description"
            label="Description"
            rules={[{ required: true, message: 'Please enter description' }]}
          >
            <Input.TextArea placeholder="Enter description" rows={2} />
          </Form.Item>

          <Form.Item
            name="raisedBy"
            label="Raised by"
            rules={[{ required: true, message: 'Please enter who raised this request' }]}
          >
            <Input placeholder="Enter name" />
          </Form.Item>

          <Form.Item
            name="requestRaised"
            label="Request Raised (DD/MM/YYYY)"
          >
            <Input 
              placeholder="DD/MM/YYYY" 
              maxLength={10}
              onChange={(e) => {
                let value = e.target.value;
                // Auto-format as user types
                if (value.length === 2 && !value.includes('/')) {
                  value = value + '/';
                } else if (value.length === 5 && (value.match(/\//g) || []).length === 1) {
                  value = value + '/';
                }
                e.target.value = value;
              }}
            />
          </Form.Item>

          <Form.Item
            name="accountAnchorAssigned"
            label="Account Anchor Assigned"
          >
            <Input placeholder="Enter name" />
          </Form.Item>

          <Form.Item
            name="processingStatus"
            label="Processing Status"
          >
            <Select
              placeholder="Select processing status"
              options={PROCESSING_STATUS_OPTIONS}
            />
          </Form.Item>

          <Form.Item
            name="updatedOn"
            label="Updated on (DD/MM/YYYY)"
          >
            <Input 
              placeholder="DD/MM/YYYY" 
              maxLength={10}
              onChange={(e) => {
                let value = e.target.value;
                // Auto-format as user types
                if (value.length === 2 && !value.includes('/')) {
                  value = value + '/';
                } else if (value.length === 5 && (value.match(/\//g) || []).length === 1) {
                  value = value + '/';
                }
                e.target.value = value;
              }}
            />
          </Form.Item>

          <Form.Item
            name="overallStatus"
            label="Overall Status"
          >
            <Select
              placeholder="Select overall status"
              options={OVERALL_STATUS_OPTIONS}
            />
          </Form.Item>

          <Form.Item>
            <Button type="primary" htmlType="submit" block>
              Save Request
            </Button>
          </Form.Item>
        </Form>
      </Drawer>

      <Drawer
        title="Column Visibility"
        placement="right"
        onClose={() => setColumnDrawer(false)}
        open={columnDrawer}
        width={300}
      >
        <Space direction="vertical" style={{ width: '100%' }}>
          {Object.entries(COLUMN_LABELS)
            .filter(([key]) => key !== 'action')
            .map(([key, label]) => (
              <div key={key} style={{ display: 'flex', alignItems: 'center', gap: 8 }}>
                <Checkbox
                  checked={visibleColumns.has(key)}
                  onChange={(e) => {
                    const newVisible = new Set(visibleColumns);
                    if (e.target.checked) {
                      newVisible.add(key);
                    } else {
                      newVisible.delete(key);
                    }
                    setVisibleColumns(newVisible);
                  }}
                />
                <label style={{ marginBottom: 0, cursor: 'pointer' }}>
                  {label}
                </label>
              </div>
            ))}
        </Space>
      </Drawer>

      <Drawer
        title="Filters"
        placement="right"
        onClose={() => setFilterDrawer(false)}
        open={filterDrawer}
        width={400}
      >
        <Space direction="vertical" style={{ width: '100%' }} size="large">
          <div>
            <Text type="secondary" style={{ fontSize: '12px', display: 'block', marginBottom: 8 }}>
              S.No
            </Text>
            <Input
              placeholder="Filter by S.No..."
              value={filters.sno}
              onChange={(e) => setFilters({ ...filters, sno: e.target.value || '' })}
              allowClear
            />
          </div>

          <div>
            <Text type="secondary" style={{ fontSize: '12px', display: 'block', marginBottom: 8 }}>
              Beeline ID
            </Text>
            <Input
              placeholder="Filter by Beeline ID..."
              value={filters.beelineId}
              onChange={(e) => setFilters({ ...filters, beelineId: e.target.value || '' })}
              allowClear
            />
          </div>

          <div>
            <Text type="secondary" style={{ fontSize: '12px', display: 'block', marginBottom: 8 }}>
              Description
            </Text>
            <Input
              placeholder="Filter by description..."
              value={filters.description}
              onChange={(e) => setFilters({ ...filters, description: e.target.value || '' })}
              allowClear
            />
          </div>

          <div>
            <Text type="secondary" style={{ fontSize: '12px', display: 'block', marginBottom: 8 }}>
              Raised by
            </Text>
            <Input
              placeholder="Filter by name..."
              value={filters.raisedBy}
              onChange={(e) => setFilters({ ...filters, raisedBy: e.target.value || '' })}
              allowClear
            />
          </div>

          <div>
            <Text type="secondary" style={{ fontSize: '12px', display: 'block', marginBottom: 8 }}>
              Account Anchor Assigned
            </Text>
            <Input
              placeholder="Filter by anchor name..."
              value={filters.accountAnchorAssigned}
              onChange={(e) => setFilters({ ...filters, accountAnchorAssigned: e.target.value || '' })}
              allowClear
            />
          </div>

          <div>
            <Text type="secondary" style={{ fontSize: '12px', display: 'block', marginBottom: 8 }}>
              Processing Status
            </Text>
            <Select
              placeholder="All statuses"
              value={filters.processingStatus || undefined}
              onChange={(value) => setFilters({ ...filters, processingStatus: value || '' })}
              allowClear
              options={PROCESSING_STATUS_OPTIONS}
            />
          </div>

          <div>
            <Text type="secondary" style={{ fontSize: '12px', display: 'block', marginBottom: 8 }}>
              Overall Status
            </Text>
            <Select
              placeholder="All overall statuses"
              value={filters.overallStatus || undefined}
              onChange={(value) => setFilters({ ...filters, overallStatus: value || '' })}
              allowClear
              options={OVERALL_STATUS_OPTIONS}
            />
          </div>

          <Button
            type="primary"
            danger
            block
            onClick={handleClearFilters}
          >
            Reset Filters
          </Button>
        </Space>
      </Drawer>

      <Drawer
        title="Bulk Update Status"
        placement="right"
        onClose={() => {
          setBulkActionDrawer(false);
          setBulkProcessingStatus('');
          setBulkOverallStatus('');
        }}
        open={bulkActionDrawer}
        width={400}
      >
        <Space direction="vertical" style={{ width: '100%' }} size="large">
          <div>
            <Text strong>Update status for {selectedRowKeys.length} record(s)</Text>
          </div>

          <div>
            <Text type="secondary" style={{ fontSize: '12px', display: 'block', marginBottom: 8 }}>
              Select Processing Status
            </Text>
            <Select
              placeholder="Select processing status"
              value={bulkProcessingStatus || undefined}
              onChange={(value) => setBulkProcessingStatus(value)}
              options={PROCESSING_STATUS_OPTIONS}
              style={{ width: '100%' }}
            />
          </div>

          <div>
            <Text type="secondary" style={{ fontSize: '12px', display: 'block', marginBottom: 8 }}>
              Select Overall Status
            </Text>
            <Select
              placeholder="Select overall status"
              value={bulkOverallStatus || undefined}
              onChange={(value) => setBulkOverallStatus(value)}
              options={OVERALL_STATUS_OPTIONS}
              style={{ width: '100%' }}
            />
          </div>

          <Text type="warning" style={{ fontSize: '12px' }}>
            Note: Selected statuses will be applied to all {selectedRowKeys.length} selected record(s)
          </Text>

          <Space style={{ width: '100%', gap: 8 }} direction="vertical">
            <Button
              type="primary"
              block
              onClick={handleBulkStatusUpdate}
              disabled={bulkProcessingStatus === '' && bulkOverallStatus === ''}
            >
              Apply to Selected
            </Button>
            <Button
              block
              onClick={() => {
                setBulkActionDrawer(false);
                setBulkProcessingStatus('');
                setBulkOverallStatus('');
              }}
            >
              Cancel
            </Button>
          </Space>
        </Space>
      </Drawer>
    </div>
  );
};

export default ClientM;





