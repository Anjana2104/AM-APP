# ─── SERVER ───────────────────────────────────────────────────────────────────
PORT=3001

# Allowed CORS origin for API requests (use exact origin in production)
ALLOWED_ORIGIN=http://localhost:5173

# ─── SECURITY ─────────────────────────────────────────────────────────────────
# Salt/pepper used when hashing user passwords.
# MUST be changed to a unique random string before deploying to production.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
EAM_PASSWORD_SALT=change_this_to_a_random_secret_in_production

# Default admin password used when seeding the initial admin account.
# MUST be changed after first login. Only used once if the admin account does not exist.
EAM_ADMIN_DEFAULT_PASSWORD=admin123

# ─── DATABASE ─────────────────────────────────────────────────────────────────
# SQLite is the default (no additional config needed).
# Uncomment and set the following for PostgreSQL or MySQL:
# DB_CLIENT=pg
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=eam
# DB_USER=postgres
# DB_PASSWORD=

# ─── LOGGING ──────────────────────────────────────────────────────────────────
# Log level: debug | info | warn | error  (default: info)
LOG_LEVEL=info
